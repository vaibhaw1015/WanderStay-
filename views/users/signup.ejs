<% layout('layouts/boilerplate') %>
<div class="auth-container">
  <h2 class="auth-title">Join WanderStay today</h2>
  <form action="/signup" method="POST" class="need-validation" novalidate>
    <div class="mb-3">
      <label for="username" class="form-label fw-semibold">Username</label>
      <input name="username" id="username" type="text" class="form-control" placeholder="Choose a username" required />
      <div class="valid-feedback">Looks good!</div>
    </div>
    <div class="mb-3">
      <label for="email" class="form-label fw-semibold">Email address</label>
      <input name="email" id="email" type="email" class="form-control" placeholder="name@example.com" required />
    </div>
    <div class="mb-4">
      <label for="password" class="form-label fw-semibold">Password</label>
      <input name="password" id="password" type="password" class="form-control" placeholder="Create a password" required />
    </div>
    <button class="btn btn-brand w-100 py-2 fs-5">Sign Up</button>
  </form>
  <div class="text-center mt-4">
    <p class="text-muted">Already have an account? <a href="/login" style="color: var(--brand-color); text-decoration: none; font-weight: 600;">Log in</a></p>
  </div>
</div>