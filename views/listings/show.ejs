<% layout("layouts/boilerplate")%>
<script>
 const mapToken="<%= process.env.MAP_TOKEN %>";
 const listing= <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-4">
  <div class="col-8 offset-2">
    <h3 class="show-title"><%=listing.title%></h3>
  </div>

  <div class="col-8 offset-2 mb-4">
    <div class="card show-card listing-card border-0">
      <img src="<%=listing.image.url %>" class="card-img-top show-img" alt="listing_image"/>
      
      <div class="card-body">
        <div class="host-info">
          <div class="host-avatar">
            <%= listing.owner.username.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h5 class="mb-0">Hosted by <%= listing.owner.username%></h5>
            <small class="text-muted">Superhost &middot; 4 years hosting</small>
          </div>
        </div>

        <div class="show-details mt-3">
          <p class="card-text fw-semibold fs-5 mb-2">&#8377;<%= listing.price.toLocaleString("en-IN") %> / night</p>
          <p class="card-text text-muted mb-2"><i class="fa-solid fa-location-dot me-2"></i><%= listing.location%>, <%= listing.country %></p>
          <p class="card-text mt-4"><%= listing.description %></p>
        </div>
      </div>
    </div> 
    
    <% if(currUser && listing.owner._id.equals(currUser._id)) {%>
    <div class="d-flex gap-3 mt-3">
      <a href="/listings/<%=listing._id %>/edit" class="btn btn-brand px-4">Edit</a> 
      <form method="POST" action="/listings/<%=listing._id %>?_method=DELETE">
        <button class="btn btn-outline-danger px-4">Delete</button>
      </form>
    </div>
    <%} %> 
  </div>
  
  <div class="col-8 offset-2 mb-4">
    <% if(currUser){%>
    <hr class="mb-4"/>
    <h4 class="mb-3">Leave a Review</h4>
    <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="rating" class="form-label fw-semibold">Rating</label> 
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1"title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      
      <div class="mb-3">
        <label for="comment" class="form-label fw-semibold">Comments</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" placeholder="Share your experience..." required></textarea>
        <div class="invalid-feedback">Please enter a valid comment.</div>
      </div>
      <button class="btn btn-brand">Submit Review</button>
    </form>
    <hr class="mt-4 mb-4"/>
    <% } %> 

    <% if(listing.reviews.length > 0){ %>
    <h4 class="mb-3"><i class="fa-solid fa-star me-2"></i>All Reviews</h4>
    <div class="row row-cols-1 row-cols-md-2 g-4">
      <% for(review of listing.reviews){%>
        <div class="col">
          <div class="review-card">
            <div class="d-flex align-items-center gap-2 mb-2">
              <div class="host-avatar" style="width: 35px; height: 35px; font-size: 0.9rem;">
                <%= review.author.username.charAt(0).toUpperCase() %>
              </div>
              <h6 class="review-author mb-0"><%=review.author.username%></h6>
            </div>
            <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
            <p class="card-text"><%= review.comment %></p>
            
            <% if(currUser && review.author._id.equals(currUser._id)) {%>
            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-sm btn-outline-danger mt-2">Delete</button>
            </form>
            <% } %>
          </div>
        </div>
      <%} %>
    </div>
    <%} %>
  </div>
  
  <div class="col-8 offset-2 mb-5">
    <hr class="mb-4"/>
    <h3 class="mb-3">Where you'll be</h3>
    <div id="map"></div>
  </div>
</div> 

<script src="/js/map.js"></script> 