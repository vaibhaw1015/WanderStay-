<% layout('layouts/boilerplate')%>

<div id="filters" class="mt-3">
  <div class="filter">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-mountain-city"></i>
    <p>Iconic Cities</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-mountain"></i>
    <p>Mountains</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-fort-awesome"></i>
    <p>Castles</p>
  </div>
  <div class="filter">
    <i class="fa-solid fa-person-swimming"></i>
    <p>Pools</p>
  </div>
  <div class="filter d-none d-md-flex">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
  </div>
  <div class="filter d-none d-lg-flex">
    <i class="fa-solid fa-cow"></i>
    <p>Farms</p>
  </div>
  <div class="filter d-none d-xl-flex">
    <i class="fa-regular fa-snowflake"></i>
    <p>Arctic</p>
  </div>
  
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch m-0">
      <input class="form-check-input shadow-none" 
      type="checkbox" 
      role="switch" 
      id="flexSwitchCheckDefault"
      />
      <label class="form-check-label ms-2 fw-semibold" for="flexSwitchCheckDefault" style="font-size: 0.9rem;"
      >Display Taxes</label>
    </div>
  </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4 mt-1">
  <% for(let listing of allListings){
  if(listing && listing._id){%>
  <div class="col">
    <a href="/listings/<%=listing._id %>" class="listing-link">
      <div class="card listing-card h-100">
        <div class="card-img-wrapper">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" />
          <div class="card-img-overlay d-flex justify-content-end p-3">
             <i class="fa-regular fa-heart text-white fs-5" style="cursor: pointer;"></i>
          </div>
        </div>
        <div class="card-body">
          <h5 class="card-title-text text-truncate"><%=listing.title%></h5>
          <p class="card-text text-muted mb-1"><%= listing.location %>, <%= listing.country %></p>
          <p class="card-price-text">
            <span>&#8377;<%= listing.price.toLocaleString("en-IN") %></span> / night
            <span class="tax-info text-muted" style="display: none; font-size: 0.85rem; font-weight: normal;"> &nbsp; +18% GST</span>
          </p>
        </div>
      </div>
    </a>
  </div>
  <% } } %>
</div>

<script>
 let taxSwitch=document.getElementById("flexSwitchCheckDefault");
 taxSwitch.addEventListener("click",()=>{
   let taxInfo=document.getElementsByClassName("tax-info");
   for(info of taxInfo){
     if(info.style.display !== "inline"){
       info.style.display="inline";
     } else {
       info.style.display="none";
     }
   }
 })
</script>
